rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc(request.auth.uid).role == 'admin';
    }

    // The ticket/cluster field each official jurisdiction is matched on —
    // the same mapping as functions/src/officials/scope.ts (SCOPE_FIELD).
    function scopeFieldFor(jurisdictionType) {
      return {
        'constituency': 'constituencyId',
        'assembly': 'assemblyId',
        'bbmpWard': 'bbmpWardId',
        'taluk': 'talukId',
        'district': 'districtId'
      }[jurisdictionType];
    }

    // Is the caller an approved official responsible for this area?
    // `area` is a ticket's `location` map or a cluster doc — both carry
    // constituencyId / assemblyId / bbmpWardId / talukId / districtId.
    //   MP → constituency, MLA → assembly seat, BBMP ward officer → ward,
    //   Tahsildar → taluk, District officer → district.
    // Officials only ever get role 'official' through the admin-only
    // reviewOfficialApplication function (or MP provisioning), never from a
    // client write. Legacy MP accounts without `jurisdiction` match on
    // their constituencyId.
    function isOfficialForArea(area) {
      let me = userDoc(request.auth.uid);
      return isSignedIn() && me.role == 'official' && (
        (me.get('jurisdiction', null) != null &&
          area.get(scopeFieldFor(me.jurisdiction.type), null) == me.jurisdiction.id) ||
        (me.get('jurisdiction', null) == null &&
          me.get('constituencyId', null) != null &&
          area.get('constituencyId', null) == me.constituencyId));
    }

    // Citizens sign in with username + password (Firebase Auth, synthetic
    // address); no email, phone or ID number is ever stored here. A user
    // may only read/write their own profile document — and may never grant
    // themselves the official role: a new profile must be a citizen, and
    // `role` can't change on update. Officials are provisioned by an admin
    // with the Admin SDK, which bypasses these rules.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'citizen';
      // An official's area is set only by the admin review function / MP
      // provisioning: they may edit their name, designation, photo etc.,
      // but never the fields their data access is scoped by.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        (resource.data.role != 'official' ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['jurisdiction', 'officialType', 'constituencyId', 'approvedAt']));
      allow delete: if false;
    }

    // Username reservations: `usernames/{username}` -> {uid}. Readable one
    // doc at a time (the Sign Up form's "is this name free?" check), never
    // listable, so the full roster can't be downloaded. Claimable once, by
    // the account it names, and never reassigned or released.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        username.matches('^[a-z0-9_.]{4,20}$');
      allow update, delete: if false;
    }

    // Hashed security-question answers. Only the Cloud Functions in
    // functions/src/citizens/ (Admin SDK) touch this; no client, not even
    // the account owner, can read or write it.
    match /userSecrets/{uid} {
      allow read, write: if false;
    }

    // Citizens create tickets only for their OWN area: the pincode on the
    // new ticket must match their own profile pincode (always present),
    // and if their profile has a resolved constituencyId, that must match
    // too (constituencyId can be null if resolution hasn't happened/found
    // no coverage yet — still allowed, just unscoped until reconciled).
    // The ticket id is generated client-side at creation time so creation
    // must never be blocked by server-side classification state.
    // Officials may only read/update tickets in their OWN constituency.
    // Suggestion (`feedback`) tickets are additionally readable by any
    // citizen in the same constituency — that's the "Trending near you"
    // feed — and any citizen in that constituency may toggle their own
    // support (only the supporterIds/supporterCount fields) on someone
    // else's suggestion, never on a problem report.
    match /submissions/{submissionId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.location.pincode == userDoc(request.auth.uid).pincodeHome &&
        (userDoc(request.auth.uid).constituencyId == null ||
         userDoc(request.auth.uid).constituencyId == request.resource.data.location.constituencyId);
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         isOfficialForArea(resource.data.location) ||
         (resource.data.submissionCategory == 'feedback' &&
          userDoc(request.auth.uid).constituencyId == resource.data.location.constituencyId));
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         isOfficialForArea(resource.data.location) ||
         (resource.data.submissionCategory == 'feedback' &&
          userDoc(request.auth.uid).constituencyId == resource.data.location.constituencyId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['supporterIds', 'supporterCount'])));
      allow delete: if false;
    }

    // Reference data (constituency/booth boundaries, AI-generated clusters)
    // is written by backend Cloud Functions (Admin SDK bypasses rules) or
    // manual seeding only — never directly by a client. `constituencies` is
    // public MP-roster info (name/photo/party), fine for any signed-in user
    // to read regardless of their own constituency. `booths` and `clusters`
    // carry per-constituency submission analytics, so — same as
    // `submissions` above — reads are scoped to the official who represents
    // that constituency, or a citizen whose own home constituency matches.
    // ---- PUBLIC PROJECTIONS ------------------------------------------
    // Cloud-Function-written denormalisations containing ONLY the
    // allowlisted safe fields in functions/src/public/projection.ts. The
    // rules on `submissions` and `users` are deliberately NOT loosened to
    // make the public dashboard work — nothing public reads them.
    //
    // That indirection is the whole privacy argument. If these rules were
    // somehow wrong tomorrow, the worst case is exposing fields a Cloud
    // Function deliberately copied here after review. There is no
    // misconfiguration that turns "the dashboard is public" into "citizen
    // home addresses are public", because the addresses were never written
    // anywhere a public reader can reach. Run `npm run backfill:public --
    // --audit` to verify what is actually in these collections.
    match /publicTickets/{submissionId} {
      allow read: if true;
      allow write: if false;
    }

    // Representative leaderboard — built server-side from publicTickets
    // only (see functions/src/public/leaderboard.ts).
    match /publicLeaderboards/{board} {
      allow read: if true;
      allow write: if false;
    }

    // Public feed comments. Created by signed-in citizens under their own
    // uid and username, born visible; screened server-side
    // (functions/src/public/feedComments.ts), which may hide them. Only
    // visible comments are readable; nobody but the server edits them.
    match /feedComments/{commentId} {
      allow read: if resource.data.hidden == false;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(
          ['ticketId', 'uid', 'username', 'text', 'createdAt', 'hidden', 'reportCount']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == userDoc(request.auth.uid).username &&
        request.resource.data.ticketId is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 1 &&
        request.resource.data.text.size() <= 280 &&
        request.resource.data.hidden == false &&
        request.resource.data.reportCount == 0 &&
        request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Which reports a citizen said "Me too" to — written only by the
    // toggleReportSupport function, readable only by that citizen.
    match /users/{userId}/supports/{ticketId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // MLA/MP/ward-name index for public report cards (seedMlaRoster.ts).
    match /publicReps/{state} {
      allow read: if true;
      allow write: if false;
    }
    match /publicClusters/{clusterId} {
      allow read: if true;
      allow write: if false;
    }

    // Public MP-roster info — name, party, photo, boundary. No citizen
    // content. Readable signed-OUT so the public dashboard works without an
    // account, which is the point of it being public.
    match /constituencies/{constituencyId} {
      allow read: if true;
      allow write: if false;
    }
    // Polling-booth catchment areas — name, lat/lng, aggregate counts,
    // dominant theme, local context. Same character as `wards`/`taluks`
    // below (a geographic reference/analytics unit, not citizen content: no
    // uid, no submission text, no address), so it gets the same public
    // read as those, which is also what lets the public map draw booth
    // density dots without an account.
    match /booths/{boothId} {
      allow read: if true;
      allow write: if false;
    }
    match /clusters/{clusterId} {
      allow read: if isSignedIn() &&
        (isOfficialForArea(resource.data) || isAdmin() ||
         userDoc(request.auth.uid).constituencyId == resource.data.constituencyId);
      allow write: if false;
    }
    // Bengaluru's 369 GBA municipal wards — each tagged with its parent
    // Lok Sabha constituencyId (see seedWards.ts).
    // Readable by anyone, including signed-out. These are published
    // government boundary polygons — geometry, names and populations — with
    // no citizen content whatsoever, and the public map needs them to draw
    // anything at all. The alternative, copying megabytes of GeoJSON into
    // each public cluster document, would be strictly worse for no privacy
    // gain. (Note a handful of wards still carry a null constituencyId
    // where their centroid fell outside all 543 boundaries.)
    match /wards/{wardId} {
      allow read: if true;
      allow write: if false;
    }
    // Karnataka's 227 taluks (KGIS/KSRSAC official data) — the
    // ward-equivalent fine-grained unit for every constituency outside
    // Bengaluru Urban. Same scoped-read pattern as wards.
    // Same reasoning as `wards` above — published KGIS/KSRSAC boundary
    // data, no citizen content, needed by the public map.
    match /taluks/{talukId} {
      allow read: if true;
      allow write: if false;
    }
    // District boundaries — a coarser reference/display layer only (a
    // district can span multiple constituencies, so it's never used for MP
    // routing). Public read, same as `wards`/`taluks`: published government
    // boundary data with no citizen content, and the District → Taluk area
    // picker is reachable without an account. Requiring sign-in here meant
    // the picker rendered an empty district list to signed-out visitors.
    match /districts/{districtId} {
      allow read: if true;
      allow write: if false;
    }

    // AI-generated Solution Cards — the output of the four-agent civic
    // intelligence chain (functions/src/agents/). World-readable, including
    // signed-out, because the whole point of the public dashboard is
    // accountability without an account.
    //
    // Safe to publish because the card is PII-free BY CONSTRUCTION, not by
    // convention: the agents are only ever shown `tokenId` +
    // AI-generated `publicSummary` per ticket (never a uid, raw citizen
    // text, pincode or exact coordinate — see agents/context.ts), and every
    // free-text field is regex-scrubbed again before it is written (see
    // reportCompilerAgent.ts). The stored centroid is already snapped to a
    // ~330m grid and omitted entirely below the k-anonymity floor.
    match /solutionCards/{clusterId} {
      allow read: if true;
      allow write: if false;

      // Transcripts are a different matter: they record each agent's raw
      // prompt and reply, which quote the ticket summaries and the model's
      // unfiltered reasoning. Officials only.
      match /agentTranscripts/{runId} {
        allow read: if isSignedIn() &&
          (userDoc(request.auth.uid).role == 'official' || isAdmin());
        allow write: if false;
      }
    }

    // Published government department contacts and grievance portals used
    // by the Routing agent. Public reference data — no citizen content —
    // and the public dashboard needs it signed-out to say who a report was
    // routed to.
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if false;
    }

    // MP unique-ID + registered-email pairs used by the first-time-setup
    // and forgot-credentials flows (see functions/src/officials/) — never
    // readable by ANY client, including the MP themselves. The whole point
    // of `uniqueId` is that it's a shared secret the Cloud Functions verify
    // server-side (via Admin SDK, which bypasses these rules entirely);
    // exposing it through a client read would defeat that.
    // Self-registration by MLAs and local officers (BBMP ward officer,
    // Tahsildar, District officer). The applicant creates their own
    // application as 'pending' and can re-submit after a rejection; only a
    // Prajadhwani admin (via the reviewOfficialApplication function) ever
    // approves one. Readable by the applicant and admins only.
    match /officialApplications/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.officialType in ['mla', 'wardOfficer', 'tahsildar', 'districtOfficer'];
      allow update: if isSignedIn() && request.auth.uid == uid &&
        resource.data.status == 'rejected' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.officialType in ['mla', 'wardOfficer', 'tahsildar', 'districtOfficer'];
      allow delete: if false;
    }

    // AI briefings per area, written only by getAreaBriefing (which also
    // serves them to the right official). Direct reads: admins only.
    match /briefings/{scopeKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Karnataka's 224 assembly constituencies (DataMeet, CC BY 2.5 India):
    // public boundary/reference data, like wards and taluks.
    match /assemblies/{assemblyId} {
      allow read: if true;
      allow write: if false;
    }

    match /mpCredentials/{constituencyId} {
      allow read, write: if false;
    }

    // Per-constituency-per-day sequence counters backing the structured
    // token id (see FirestoreService.generateTokenId) — incremented
    // directly by the citizen's own client via a transaction at ticket
    // creation time, so it can't wait on a Cloud Function round-trip. Only
    // a single numeric `count` field is ever allowed. Read access is
    // required here — the increment transaction itself does a tx.get() on
    // this doc before writing, and a denied read fails the whole
    // transaction (this used to be `allow read: if false`, which silently
    // broke every single ticket submission's token generation).
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count is int &&
        request.resource.data.count > 0;
      allow delete: if false;
    }
  }
}
