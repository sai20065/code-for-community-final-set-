rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Voice/photo ticket media: only the uploading citizen may write their
    // own file; the file is readable by its owner or any official (needed
    // for the Gemini vision/Bhashini pipeline and for officials reviewing
    // a ticket's attached media).
    match /submissions/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'official');
    }

    // Optional citizen profile photo. Private to its owner: only they can
    // write it (an image under 1 MB) or read it — the app loads it through
    // the SDK, never via a public download URL.
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ID / appointment-letter photo from a self-registering MLA or officer.
    // Written by the applicant; readable by them and by Prajadhwani admins
    // reviewing the application — nobody else.
    match /officialProofs/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/pdf');
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // AI-generated constituency PDF reports (see generateConstituencyReport
    // Cloud Function) — written only by the function's Admin SDK identity;
    // readable only by the official who represents that exact constituency.
    match /reports/{constituencyId}/{fileName} {
      allow write: if false;
      allow read: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'official' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.constituencyId == constituencyId;
    }

    // Deliberately public, unauthenticated-read bucket for anything meant
    // to be shared with a plain URL (e.g. a demo APK for a hackathon) —
    // never written by any client, only by an operator via the Admin SDK/
    // console. Everything else in this project stays scoped by default;
    // only paths explicitly placed under public/ are exposed this way.
    match /public/{fileName} {
      allow write: if false;
      allow read: if true;
    }

    // Blurred, EXIF-free public copies of report photos for the citizen
    // feed — written only by the publishPhoto function after the citizen
    // opted in, never by a client.
    match /public/feed/{fileName} {
      allow write: if false;
      allow read: if true;
    }
  }
}
